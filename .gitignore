# ============================================================
# SPVC 仓库忽略规则
# 说明：.gitignore 只影响“未跟踪”文件；已经提交的大文件
# 需要 git rm --cached 才会移出索引，历史仍需 filter-repo/BFG
# 才会真正缩小 .git。见 GIT_CLEANUP.md。
# ============================================================

# --- OS / editor ---
.DS_Store
Thumbs.db
.obsidian/
.claude/
.idea/
.vscode/

# --- Python ---
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/
build/
dist/
.venv/
.venv-*/
venv/

# --- external visual backbone (large, reproducible asset) ---
external/dinov2/
external/dinov2_weights/

# --- nested reference checkout (has its own .git) ---
# 若要版本化，改成 git submodule；不要把内部 .git 直接提交。
VISION-SLS/

# --- raw / collected datasets ---
carla_data_spvc_expanded/
data/lane_keeping_v2/
data/lane_keeping*/
*.h5
*.hdf5
*.bag
*.mcap

# --- large model / tensor / archive artifacts ---
# 结果包保留 README/JSON/CSV/小图；大权重、特征、数组、压缩包不进 Git。
*.pt
*.pth
*.ckpt
*.safetensors
*.onnx
*.pkl
*.pickle
*.npz
*.npy
*.zip
*.tar
*.tar.gz
*.tgz
*.7z
*.rar

# --- local scratch / server snapshots / temporary captures ---
tmp/
work/
logs/
*.log

# --- accidentally copied absolute paths / duplicate result dirs ---
Users/
real_aebs_artifact_v1/
real_aebs_artifact_v2/
real_image_aebs_probe_v1/

# --- local site build cache (site itself is tracked) ---
site/.cache/
